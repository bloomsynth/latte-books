-        let offset = self.cursor_boundary(offset.saturating_sub(1), Bias::Left);
+        let offset = self.cursor_boundary(self.previous_grapheme_start(offset), Bias::Left);
         self.clamp_offset_to_visible_backward(offset)
     }
 
+    /// The cursor stop after `offset`: the end of the next grapheme cluster.

+    /// The previous character boundary, used by Backspace. Deleting one code point at a
+    /// time lets Indic users correct a vowel sign without retyping its consonant (कि → क).
+    pub(super) fn previous_char_boundary(&self, offset: usize) -> usize {
+        let offset = self.cursor_boundary(offset.saturating_sub(1), Bias::Left);
+        self.clamp_offset_to_visible_backward(offset)
+    }
+
+    fn previous_grapheme_start(&self, offset: usize) -> usize {
+        let row = self.text.offset_to_point(offset).row;
+        let line_start = self.text.line_start_offset(row);
+        if offset <= line_start {
+            return offset.saturating_sub(1);
+        }
+        let before = self.text.slice(line_start..offset).to_string();
+        before
+            .grapheme_indices(true)
+            .next_back()
+            .map_or(offset - 1, |(ix, _)| line_start + ix)
+    }
+
+    fn next_grapheme_end(&self, offset: usize) -> usize {
+        let row = self.text.offset_to_point(offset).row;
+        let line_end = self.text.line_end_offset(row);
+        if offset >= line_end {
+            return offset.saturating_add(1);
+        }
+        let after = self.text.slice(offset..line_end).to_string();
+        after
+            .graphemes(true)
+            .next()
+            .map_or(offset + 1, |grapheme| offset + grapheme.len())
+    }
+
